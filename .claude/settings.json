{
  "permissions": {
    "allow": [
      "Bash(xcrun swift:*)",
      "Bash(xcode-select -p)",
      "Bash(uniq done:*)",
      "Bash(gh run:*)",
      "Bash(gh search:*)",
      "Bash(gh issue:*)",
      "WebFetch(domain:ollama.com)",
      "Bash(mise run build:*)",
      "Bash(mise run test:*)",
      "Bash(mise run build-dev:*)",
      "Bash(mise run fmt:*)",
      "Bash(mise run lint:*)",
      "Bash(container run:*)"
    ]
  },
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "mcp-server-dev@claude-plugins-official": true,
    "finance@knowledge-work-plugins": true
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": []
    }
  }
}
