{
  "permissions": {
    "allow": [
      "Bash(xcrun swift:*)",
      "Bash(xcode-select -p)",
      "Bash(uniq done:*)",
      "Bash(gh run:*)",
      "Bash(gh search:*)",
      "Bash(gh issue:*)",
      "WebFetch(domain:ollama.com)",
      "Bash(mise build:*)",
      "Bash(mise test:*)",
      "Bash(mise build-dev:*)",
      "Bash(mise fmt:*)",
      "Bash(mise lint:*)"
    ]
  },
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true
  }
}
